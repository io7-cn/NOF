<Project>
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <CentralPackageTransitivePinningEnabled>true</CentralPackageTransitivePinningEnabled>
  </PropertyGroup>
  <ItemGroup>
    <PackageVersion Include="OpenIddict.Server.AspNetCore" Version="7.7.2" />
    <PackageVersion Include="OpenIddict.EntityFrameworkCore" Version="7.7.2" />

    <PackageVersion Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="[11.0.0,11.1.0)" />
    <!-- SourceGenerator -->
    <PackageVersion Include="Microsoft.CodeAnalysis.Common" Version="5.9.0" />
    <PackageVersion Include="Microsoft.CodeAnalysis.CSharp" Version="5.9.0" />
    <PackageVersion Include="Microsoft.CodeAnalysis.CSharp.Workspaces" Version="5.9.0" />
    <PackageVersion Include="Microsoft.CodeAnalysis.Analyzers" Version="5.9.0" />
    <!-- Application -->
    <PackageVersion Include="Microsoft.Extensions.DependencyInjection" Version="[11.0.0,11.1.0)" />
    <PackageVersion Include="Microsoft.Extensions.Configuration" Version="[11.0.0,11.1.0)" />
    <!-- Infrastructure.Abstraction -->
    <PackageVersion Include="Microsoft.Extensions.Logging" Version="[11.0.0,11.1.0)" />
    <PackageVersion Include="Microsoft.Extensions.Http" Version="[11.0.0,11.1.0)" />
    <PackageVersion Include="Microsoft.Extensions.Hosting" Version="[11.0.0,11.1.0)" />
    <!-- Infrastructure.Core -->
    <PackageVersion Include="OpenTelemetry.Exporter.OpenTelemetryProtocol" Version="[1.15.3,1.16.0)" />
    <PackageVersion Include="OpenTelemetry.Extensions.Hosting" Version="[1.15.0,1.16.0)" />
    <PackageVersion Include="OpenTelemetry.Instrumentation.Http" Version="[1.15.0,1.16.0)" />
    <PackageVersion Include="OpenTelemetry.Instrumentation.Runtime" Version="[1.15.0,1.16.0)" />
    <!-- Hosting -->
    <PackageVersion Include="Microsoft.AspNetCore.Components" Version="[11.0.0,11.1.0)" />
    <PackageVersion Include="Microsoft.AspNetCore.Components.WebAssembly" Version="[11.0.0,11.1.0)" />
    <PackageVersion Include="Microsoft.AspNetCore.OpenApi" Version="[11.0.0,11.1.0)" />
    <PackageVersion Include="Microsoft.OpenApi" Version="[3.11.0,4.0.0)" />
    <PackageVersion Include="Microsoft.JSInterop" Version="[11.0.0,11.1.0)" />
    <PackageVersion Include="OpenTelemetry.Instrumentation.AspNetCore" Version="[1.15.0,1.16.0)" />
    <!-- Extensions -->
    <PackageVersion Include="System.IdentityModel.Tokens.Jwt" Version="[8.19.2,8.20.0)" />
    <!-- Infrastructure: retain EF Core 10 until the PostgreSQL provider has a stable 11.x release. -->
    <PackageVersion Include="AWSSDK.S3" Version="[4.0.102.4,4.1.0)" />
    <PackageVersion Include="RabbitMQ.Client" Version="[7.1.2,7.2.0)" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore" Version="[10.0.11,10.1.0)" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Relational" Version="[10.0.11,10.1.0)" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Sqlite" Version="[10.0.11,10.1.0)" />
    <PackageVersion Include="NHibernate" Version="[5.6.0,5.7.0)" />
    <PackageVersion Include="SQLitePCLRaw.bundle_e_sqlite3" Version="[3.0.3,4.0.0)" />
    <PackageVersion Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="[10.0.0,10.1.0)" />
    <PackageVersion Include="StackExchange.Redis" Version="[2.10.14,2.11.0)" />
    <!-- Test -->
    <PackageVersion Include="Microsoft.AspNetCore.Http" Version="2.3.9" />
    <PackageVersion Include="Microsoft.AspNetCore.TestHost" Version="[11.0.0,11.1.0)" />
    <PackageVersion Include="Microsoft.CodeAnalysis.CSharp.SourceGenerators.Testing" Version="1.1.3" />
    <PackageVersion Include="Microsoft.CodeAnalysis.Workspaces.Common" Version="5.9.0" />
    <PackageVersion Include="Microsoft.CodeAnalysis.Workspaces.MSBuild" Version="5.9.0" />
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="18.0.1" />
    <PackageVersion Include="Moq" Version="4.20.72" />
    <PackageVersion Include="xunit" Version="2.9.3" />
    <PackageVersion Include="xunit.runner.visualstudio" Version="3.1.5" />
  </ItemGroup>
</Project>
