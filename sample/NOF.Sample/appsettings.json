{
    "Logging": {
        "LogLevel": {
            "Default": "Debug",
            "Microsoft.AspNetCore": "Warning",
            "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
        }
    },
    "ConnectionStrings": {
        "postgres": "Host=localhost;Port=52894;Database=db2;Username=postgres;Password=123456",
        "redis": "Host=localhost;Port=6379",
        "rabbitmq": "amqp://guest:guest@localhost:5672/"
    },
    "NOF": {
        "OidcServer": {
            "Issuer": "NOF.Sample",
            "KeySize": 2048,
            "RetiredKeyRetentionCount": 2,
            "KeyRotationInterval": "30.00:00:00",
            "SigningKeyEncryptionKey": "MDEyMzQ1Njc4OWFiY2RlZjAxMjM0NTY3ODlhYmNkZWY="
        },
        "Jwt": {
            "Authority": {
                "Issuer": "NOF.Sample"
            }
        },
        "Outbox": {
            "PollingInterval": "00:00:05",
            "BatchSize": 100,
            "MaxRetryCount": 5,
            "ClaimTimeout": "00:05:00"
        },
        "DbContextFactory": {
            "AutoMigrate": false
        },
        "HttpHeaderMiddleware": {
            "BlacklistedPatterns": [
                "NOF.*"
            ]
        }
    }
}
