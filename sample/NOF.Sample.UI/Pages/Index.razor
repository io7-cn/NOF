@page "/"
@using System.Text.Json
@inject SampleMessageService Message
@inject ISampleApi NOFService

<PageTitle>配置中心</PageTitle>

<div class="sample-page">
    <h1>配置中心</h1>
    <div class="sample-config-grid">
        <section class="sample-card">
            <div class="sample-section-heading">
                <h2>配置树</h2>
                <button type="button" class="sample-primary" @onclick="() => ShowCreateNodeModal(null)">添加根节点</button>
            </div>
            <ConfigTree OnSelectNode="OnNodeSelected" OnAddChild="ShowCreateNodeModal" OnDeleteNode="id => _pendingDeleteNode = id" @ref="_tree" />
        </section>
        <div>
            @if (_selectedNode is not null)
            {
                <section class="sample-card">
                    <div class="sample-section-heading"><h2>@_node?.Name · 配置文件</h2><button type="button" @onclick="ShowCreateFileModal">添加文件</button></div>
                    <div class="sample-files-grid">
                        <nav aria-label="配置文件" class="sample-file-list">
                            @if (_node?.ConfigFiles is not null)
                            {
                                @foreach (var file in _node.ConfigFiles)
                                {
                                    <button type="button" class="@(_selectedFile == file.Name ? "sample-selected" : "")" @onclick="() => OnFileSelected(file.Name)">
                                        @file.Name @if (_node.ActiveFileName == file.Name) { <span class="sample-tag">激活</span> }
                                    </button>
                                }
                            }
                        </nav>
                        <div class="sample-form">
                            @if (_selectedFile is not null)
                            {
                                <h3>@_selectedFile</h3>
                                <label>文件内容<textarea rows="16" @bind="_fileContent" @bind:event="oninput"></textarea></label>
                                <div class="sample-actions">
                                    <button type="button" class="sample-primary" @onclick="SaveCurrentFile">保存文件</button>
                                    @if (_node?.ActiveFileName != _selectedFile)
                                    {
                                        <button type="button" @onclick="() => SetActiveFile(_selectedFile)">设为激活</button>
                                    }
                                    <button type="button" class="sample-danger" @onclick="() => _pendingDeleteFile = _selectedFile">删除文件</button>
                                </div>
                            }
                            else
                            {
                                <p class="sample-empty">请选择一个配置文件，或添加新文件。</p>
                            }
                        </div>
                    </div>
                </section>
                <section class="sample-card">
                    <div class="sample-section-heading"><h2>配置预览</h2><button type="button" @onclick="LoadPreview">刷新预览</button></div>
                    @if (_previewLoading) { <p role="status">正在加载…</p> }
                    else if (!string.IsNullOrEmpty(_previewContent)) { <pre>@_previewContent</pre> }
                    else { <p class="sample-empty">暂无预览内容</p> }
                </section>
            }
            else
            {
                <section class="sample-card"><p class="sample-empty">请选择一个配置节点。</p></section>
            }
        </div>
    </div>
</div>

@if (_createNodeModalVisible)
{
    <div class="sample-modal-backdrop">
        <section class="sample-modal sample-form" role="dialog" aria-modal="true" aria-labelledby="create-node-title">
            <h2 id="create-node-title">创建节点</h2>
            <label>节点名称<input @bind:event="oninput" @bind="_createNodeModel.Name" placeholder="请输入节点名称" /></label>
            <div class="sample-actions"><button type="button" class="sample-primary" @onclick="CreateNode">创建</button><button type="button" @onclick="() => _createNodeModalVisible = false">取消</button></div>
        </section>
    </div>
}
@if (_fileModalVisible)
{
    <div class="sample-modal-backdrop">
        <section class="sample-modal sample-form" role="dialog" aria-modal="true" aria-labelledby="create-file-title">
            <h2 id="create-file-title">创建配置文件</h2>
            <label>文件名<input @bind:event="oninput" @bind="_fileModel.Name" placeholder="例如: appsettings.json" /></label>
            <label>内容 (JSON)<textarea @bind:event="oninput" @bind="_fileModel.Content" rows="10" placeholder="{}"></textarea></label>
            <div class="sample-actions"><button type="button" class="sample-primary" @onclick="SaveFile">保存</button><button type="button" @onclick="() => _fileModalVisible = false">取消</button></div>
        </section>
    </div>
}
@if (_pendingDeleteNode is not null || _pendingDeleteFile is not null)
{
    <div class="sample-modal-backdrop">
        <section class="sample-modal" role="dialog" aria-modal="true" aria-labelledby="delete-title">
            <h2 id="delete-title">确认删除</h2>
            <p>@(_pendingDeleteFile is not null ? $"确定删除文件 {_pendingDeleteFile} 吗？" : "确定删除此配置节点吗？")</p>
            <div class="sample-actions">
                <button type="button" class="sample-danger" @onclick="async () => { if (_pendingDeleteFile is not null) { await DeleteFile(_pendingDeleteFile); } else if (_pendingDeleteNode is long id) { await DeleteNode(id); } _pendingDeleteNode = null; _pendingDeleteFile = null; }">确认删除</button>
                <button type="button" @onclick="() => { _pendingDeleteNode = null; _pendingDeleteFile = null; }">取消</button>
            </div>
        </section>
    </div>
}

@code {
    private ConfigTree? _tree;
    private long? _selectedNode;
    private ConfigNodeDto? _node;
    private string? _selectedFile;
    private string _fileContent = "";
    private bool _previewLoading;
    private string _previewContent = "";

    private bool _createNodeModalVisible;
    private CreateNodeModel _createNodeModel = new();
    private long? _creatingChildFor;

    private long? _pendingDeleteNode;
    private string? _pendingDeleteFile;
    private bool _fileModalVisible;
    private FileModel _fileModel = new();

    private async Task OnNodeSelected(long nodeId)
    {
        _selectedNode = nodeId;
        _selectedFile = null;
        _fileContent = "";
        await LoadNode();
        await LoadPreview();
    }

    private async Task LoadNode()
    {
        if (_selectedNode.HasValue)
        {
            var result = await NOFService.GetConfigNodeByIdAsync(new GetConfigNodeByIdRequest
            {
                Id = _selectedNode.Value
            }, NOF.Abstraction.Context.Empty);
            var response = Message.UnwrapWithMessage(result);
            _node = response?.Node;
            StateHasChanged();
        }
    }

    private void OnFileSelected(string fileName)
    {
        _selectedFile = fileName;
        var file = _node?.ConfigFiles.FirstOrDefault(f => f.Name == _selectedFile);
        if (file != null)
        {
            _fileContent = file.Content;
        }
    }

    private async Task SaveCurrentFile()
    {
        if (_selectedNode.HasValue && !string.IsNullOrEmpty(_selectedFile))
        {
            try
            {
                using var document = JsonDocument.Parse(_fileContent);
            }
            catch
            {
                Message.Error("JSON 格式无效");
                return;
            }

            var result = await NOFService.AddOrUpdateConfigFileAsync(new AddOrUpdateConfigFileRequest
            {
                NodeId = _selectedNode.Value,
                FileName = _selectedFile,
                Content = _fileContent
            }, NOF.Abstraction.Context.Empty);
            if (result.Value is NOF.Contract.Empty)
            {
                Message.Success("保存成功");
                await LoadNode();
            }
            else
            {
                Message.Error($"保存失败: {result.GetRpcFailureMessage()}");
            }
        }
    }

    private async Task LoadPreview()
    {
        if (!_selectedNode.HasValue)
        {
            return;
        }

        _previewLoading = true;
        _previewContent = "";

        try
        {
            var result = await NOFService.GetConfigNodeByIdAsync(new GetConfigNodeByIdRequest
            {
                Id = _selectedNode.Value
            }, NOF.Abstraction.Context.Empty);
            var node = Message.UnwrapWithMessage(result);
            if (node?.Node != null)
            {
                var response = await NOFService.GetConfigurationAsync(new GetConfigurationRequest
                {
                    AppName = node.Node.Name
                }, NOF.Abstraction.Context.Empty);
                var configuration = Message.UnwrapWithMessage(response);
                if (configuration != null)
                {
                    _previewContent = FormatJson(configuration.Content);
                }
            }
        }
        catch (Exception ex)
        {
            _previewContent = $"加载失败: {ex.Message}";
        }
        finally
        {
            _previewLoading = false;
        }
    }

    private string FormatJson(string json)
    {
        try
        {
            using var doc = JsonDocument.Parse(json);
            return JsonSerializer.Serialize(doc, new JsonSerializerOptions { WriteIndented = true });
        }
        catch
        {
            return json;
        }
    }

    private void ShowCreateNodeModal(long? parentId)
    {
        _creatingChildFor = parentId;
        _createNodeModel = new CreateNodeModel();
        _createNodeModalVisible = true;
    }

    private async Task CreateNode()
    {
        if (string.IsNullOrWhiteSpace(_createNodeModel.Name))
        {
            Message.Error("节点名称不能为空");
            return;
        }

        var result = await NOFService.CreateConfigNodeAsync(new CreateConfigNodeRequest
        {
            Name = _createNodeModel.Name,
            ParentId = _creatingChildFor
        }, NOF.Abstraction.Context.Empty);
        if (result.Value is NOF.Contract.Empty)
        {
            Message.Success("节点创建成功");
            _createNodeModalVisible = false;
            if (_tree != null)
            {
                await _tree.ReloadNode(_creatingChildFor);
            }
        }
        else
        {
            Message.Error($"创建失败: {result.GetRpcFailureMessage()}");
        }
    }

    private async Task DeleteNode(long nodeId)
    {
        var result = await NOFService.DeleteConfigNodeAsync(new DeleteConfigNodeRequest
        {
            Id = nodeId
        }, NOF.Abstraction.Context.Empty);
        if (result.Value is NOF.Contract.Empty)
        {
            Message.Success("节点删除成功");
            if (_selectedNode == nodeId)
            {
                _selectedNode = null;
                _node = null;
                _selectedFile = null;
            }
            if (_tree != null)
            {
                await _tree.ReloadNode(null);
            }
        }
        else
        {
            Message.Error($"删除失败: {result.GetRpcFailureMessage()}");
        }
    }

    private void ShowCreateFileModal()
    {
        _fileModel = new FileModel();
        _fileModalVisible = true;
    }

    private async Task SaveFile()
    {
        if (string.IsNullOrWhiteSpace(_fileModel.Name))
        {
            Message.Error("文件名不能为空");
            return;
        }

        try
        {
            using var document = JsonDocument.Parse(_fileModel.Content);
        }
        catch
        {
            Message.Error("JSON 格式无效");
            return;
        }

        if (_selectedNode.HasValue)
        {
            var result = await NOFService.AddOrUpdateConfigFileAsync(new AddOrUpdateConfigFileRequest
            {
                NodeId = _selectedNode.Value,
                FileName = _fileModel.Name,
                Content = _fileModel.Content
            }, NOF.Abstraction.Context.Empty);
            if (result.Value is NOF.Contract.Empty)
            {
                Message.Success("文件保存成功");
                _selectedFile = _fileModel.Name;
                _fileContent = _fileModel.Content;
                _fileModalVisible = false;
                await LoadNode();
            }
            else
            {
                Message.Error($"保存失败: {result.GetRpcFailureMessage()}");
            }
        }
    }

    private async Task DeleteFile(string fileName)
    {
        if (_selectedNode.HasValue)
        {
            var result = await NOFService.RemoveConfigFileAsync(new RemoveConfigFileRequest
            {
                NodeId = _selectedNode.Value,
                FileName = fileName
            }, NOF.Abstraction.Context.Empty);
            if (result.Value is NOF.Contract.Empty)
            {
                Message.Success("文件删除成功");
                if (_selectedFile == fileName)
                {
                    _selectedFile = null;
                    _fileContent = "";
                }
                await LoadNode();
            }
            else
            {
                Message.Error($"删除失败: {result.GetRpcFailureMessage()}");
            }
        }
    }

    private async Task SetActiveFile(string fileName)
    {
        if (_selectedNode.HasValue)
        {
            var result = await NOFService.SetActiveFileAsync(new SetActiveFileRequest
            {
                NodeId = _selectedNode.Value,
                FileName = fileName
            }, NOF.Abstraction.Context.Empty);
            if (result.Value is NOF.Contract.Empty)
            {
                Message.Success("已设为激活文件");
                await LoadNode();
            }
            else
            {
                Message.Error($"设置失败: {result.GetRpcFailureMessage()}");
            }
        }
    }

    public class CreateNodeModel
    {
        public string Name { get; set; } = "";
    }

    public class FileModel
    {
        public string Name { get; set; } = "";
        public string Content { get; set; } = "{}";
    }
}
