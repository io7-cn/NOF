@page "/permissions-demo"
@using NOF.Abstraction
@using NOF.UI.Components
@inject PermissionCatalog Catalog

<PageTitle>权限目录</PageTitle>
<div class="sample-page">
    <h1>权限目录</h1>
    <section class="sample-card">
        <table>
            <thead><tr><th>权限</th><th>标识</th><th>分组</th></tr></thead>
            <tbody>
                @foreach (var permission in Catalog.GetAll())
                {
                    <tr><td>@permission.Name</td><td>@permission.Id</td><td>@permission.Group</td></tr>
                }
            </tbody>
        </table>
        <AuthGuard Permission="@SamplePermissions.ViewDirectory">
            <ChildContent><p>当前身份具有目录查看权限。</p></ChildContent>
            <UnauthorizedContent><p>当前身份尚未获得目录查看权限。</p></UnauthorizedContent>
        </AuthGuard>
        <a href="/api/permissions/overview" target="_blank" rel="noopener">查看服务端检查结果</a>
    </section>
</div>
