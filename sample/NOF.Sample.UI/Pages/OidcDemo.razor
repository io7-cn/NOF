@page "/oidc-demo"
@using System.Security.Cryptography
@using System.Text
@inject NavigationManager NavigationManager

<PageTitle>OIDC Demo</PageTitle>

<div class="sample-page">
    <h1>OIDC Demo</h1>
    <p class="sample-muted">OAuth 2.1 / OpenID Connect 演示。演示服务使用固定用户 demo-user。</p>
    <div class="sample-grid">
        <section class="sample-card">
            <h2>Discovery Endpoints</h2>
            <dl class="sample-details">
                <dt>Issuer</dt><dd>@Issuer</dd>
                <dt>OpenID Configuration</dt><dd><a href="@OpenIdConfigurationUrl" target="_blank" rel="noopener">查看 OpenID 配置</a></dd>
                <dt>Authorization Server Metadata</dt><dd><a href="@AuthorizationMetadataUrl" target="_blank" rel="noopener">查看授权服务元数据</a></dd>
                <dt>JWKS</dt><dd><a href="@JwksUrl" target="_blank" rel="noopener">查看签名公钥</a></dd>
                <dt>Authorize</dt><dd>@AuthorizeEndpoint</dd>
                <dt>Token</dt><dd>@TokenEndpoint</dd>
                <dt>UserInfo</dt><dd>@UserInfoEndpoint</dd>
            </dl>
        </section>
        <section class="sample-card">
            <h2>Authorize URL Builder</h2>
            <div class="sample-form">
                <label>Client ID<input @bind:event="oninput" @bind="_model.ClientId" /></label>
                <label>Redirect URI<input @bind:event="oninput" @bind="_model.RedirectUri" /></label>
                <label>Scope<input @bind:event="oninput" @bind="_model.Scope" /></label>
                <label>State<input @bind:event="oninput" @bind="_model.State" /></label>
                <label>Nonce<input @bind:event="oninput" @bind="_model.Nonce" /></label>
                <div class="sample-actions">
                    <button type="button" @onclick="GeneratePkce">Generate PKCE</button>
                    <button type="button" class="sample-primary" @onclick="BuildAuthorizeUrl">Build URL</button>
                </div>
            </div>
        </section>
        <section class="sample-card">
            <h2>PKCE</h2>
            <h3>Code Verifier</h3><pre>@_model.CodeVerifier</pre>
            <h3>Code Challenge · S256</h3><pre>@_model.CodeChallenge</pre>
        </section>
        <section class="sample-card">
            <h2>Authorization Request</h2>
            <pre>@_authorizeUrl</pre>
            <p>使用生成的地址取得授权码，再结合上面的 Code Verifier 调用 Token 端点。</p>
        </section>
    </div>
    <section class="sample-card">
        <h2>Try It</h2>
        <ol><li>使用生成的授权地址获取授权码。</li><li>将授权码和 Code Verifier 提交到 Token 端点。</li><li>用返回的 Bearer Token 调用 UserInfo 端点。</li></ol>
        <pre>curl -X POST @TokenEndpoint -H "Content-Type: application/x-www-form-urlencoded" -d "grant_type=authorization_code&amp;client_id=@_model.ClientId&amp;code=YOUR_CODE&amp;redirect_uri=@Uri.EscapeDataString(_model.RedirectUri)&amp;code_verifier=@_model.CodeVerifier"</pre>
    </section>
</div>

@code {
    private readonly OidcDemoModel _model = new();
    private string _authorizeUrl = string.Empty;

    private string BaseUri => NavigationManager.BaseUri.TrimEnd('/');
    private string Issuer => $"{BaseUri}/oauth2";
    private string OpenIdConfigurationUrl => $"{Issuer}/.well-known/openid-configuration";
    private string AuthorizationMetadataUrl => $"{BaseUri}/.well-known/oauth-authorization-server/oauth2";
    private string JwksUrl => $"{Issuer}/.well-known/jwks.json";
    private string AuthorizeEndpoint => $"{Issuer}/authorize";
    private string TokenEndpoint => $"{Issuer}/token";
    private string UserInfoEndpoint => $"{Issuer}/userinfo";

    protected override void OnInitialized()
    {
        _model.RedirectUri = $"{BaseUri}/oauth/callback";
        GeneratePkce();
        BuildAuthorizeUrl();
    }

    private void GeneratePkce()
    {
        Span<byte> buffer = stackalloc byte[32];
        RandomNumberGenerator.Fill(buffer);

        _model.CodeVerifier = Base64UrlEncode(buffer.ToArray());
        _model.CodeChallenge = Base64UrlEncode(SHA256.HashData(Encoding.ASCII.GetBytes(_model.CodeVerifier)));
        BuildAuthorizeUrl();
    }

    private void BuildAuthorizeUrl()
    {
        _authorizeUrl =
            $"{AuthorizeEndpoint}?response_type=code" +
            $"&client_id={Uri.EscapeDataString(_model.ClientId)}" +
            $"&redirect_uri={Uri.EscapeDataString(_model.RedirectUri)}" +
            $"&scope={Uri.EscapeDataString(_model.Scope)}" +
            $"&state={Uri.EscapeDataString(_model.State)}" +
            $"&nonce={Uri.EscapeDataString(_model.Nonce)}" +
            $"&code_challenge={Uri.EscapeDataString(_model.CodeChallenge)}" +
            "&code_challenge_method=S256";
    }

    private static string Base64UrlEncode(byte[] value)
    {
        return Convert.ToBase64String(value)
            .TrimEnd('=')
            .Replace('+', '-')
            .Replace('/', '_');
    }

    public sealed class OidcDemoModel
    {
        public string ClientId { get; set; } = "nof-sample-ui";

        public string RedirectUri { get; set; } = string.Empty;

        public string Scope { get; set; } = "openid profile email";

        public string State { get; set; } = "sample-state";

        public string Nonce { get; set; } = "sample-nonce";

        public string CodeVerifier { get; set; } = string.Empty;

        public string CodeChallenge { get; set; } = string.Empty;
    }
}
