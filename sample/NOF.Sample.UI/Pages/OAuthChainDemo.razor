@page "/oauth-chain-demo"
@using System.Text.Json
@inject SampleMessageService Message
@inject IOAuthDemoApi OAuthDemoService

<PageTitle>OAuth Chain Demo</PageTitle>

<div class="sample-page">
    <h1>OAuth Chain Demo</h1>
    <p class="sample-muted">依次创建 Client、获取服务与用户 Token、交换 Token，最后调用下游服务。</p>
    <p role="status">@(_busy ? _busyText : "准备就绪")</p>
    <fieldset class="sample-fieldset" disabled="@_busy">
        <div class="sample-grid">
            <section class="sample-card">
                <h2>Step 1. 生成 Client</h2>
                <p>创建一个演示 OAuth client，并返回一次性的 ClientSecret。</p>
                <button type="button" class="sample-primary" @onclick="CreateClientAsync">生成 Client</button>
                <pre>@_step1Result</pre>
            </section>
            <section class="sample-card">
                <h2>Step 2. Client 用凭证获取 Token</h2>
                <p>通过 Client Credentials 获取服务 Token。</p>
                <button type="button" class="sample-primary" disabled="@string.IsNullOrWhiteSpace(_clientSecret)" @onclick="GetClientTokenAsync">获取 Client Token</button>
                <pre>@_step2Result</pre>
            </section>
            <section class="sample-card">
                <h2>Step 3. User 获取 Token</h2>
                <p>通过授权码和 PKCE 为 demo-user 获取 Token。</p>
                <button type="button" class="sample-primary" disabled="@string.IsNullOrWhiteSpace(_clientId)" @onclick="GetUserTokenAsync">获取 User Token</button>
                <pre>@_step3Result</pre>
            </section>
            <section class="sample-card">
                <h2>Step 4. Client 发起 Token Exchange</h2>
                <p>以用户 Token 和服务 Token 发起交换。</p>
                <button type="button" class="sample-primary" disabled="@(string.IsNullOrWhiteSpace(_clientAccessToken) || string.IsNullOrWhiteSpace(_userAccessToken))" @onclick="ExchangeUserTokenAsync">发起 Token Exchange</button>
                <pre>@_step4Result</pre>
            </section>
        </div>
        <section class="sample-card">
            <h2>Step 5. Downstream 消费交换后的 Token</h2>
            <p>调用下游服务，读取标准 act claim 链。</p>
            <button type="button" class="sample-primary" disabled="@string.IsNullOrWhiteSpace(_exchangedAccessToken)" @onclick="ConsumeExchangedTokenAsync">调用 Downstream</button>
            <pre>@_step5Result</pre>
        </section>
    </fieldset>
</div>

@code {
    private readonly JsonSerializerOptions _jsonOptions = new(JsonSerializerDefaults.Web)
    {
        WriteIndented = true
    };

    private const string RequestedExchangeScope = "sample.read";

    private bool _busy;
    private string _busyText = "执行中...";

    private string? _clientId;
    private string? _clientSecret;
    private string? _clientAccessToken;
    private string? _userAccessToken;
    private string? _exchangedAccessToken;

    private string _step1Result = "尚未执行";
    private string _step2Result = "尚未执行";
    private string _step3Result = "尚未执行";
    private string _step4Result = "尚未执行";
    private string _step5Result = "尚未执行";

    private async Task CreateClientAsync()
    {
        await ExecuteStepAsync("正在生成 Client...", async () =>
        {
            var result = await OAuthDemoService.CreateClientAsync(
                new CreateDemoOAuthClientRequest(),
                Context.Empty);

            if (result.Value is not CreateDemoOAuthClientResponse success)
            {
                throw new InvalidOperationException(result.GetRpcFailureMessage());
            }

            _clientId = success.ClientId;
            _clientSecret = success.ClientSecret;
            _clientAccessToken = null;
            _exchangedAccessToken = null;
            _step1Result = JsonSerializer.Serialize(success, _jsonOptions);
            _step2Result = "尚未执行";
            _step4Result = "尚未执行";
            _step5Result = "尚未执行";
        });
    }

    private async Task GetClientTokenAsync()
    {
        await ExecuteStepAsync("正在用 Client 凭证获取 Token...", async () =>
        {
            var result = await OAuthDemoService.GetClientTokenAsync(
                new GetDemoClientTokenRequest
                {
                    ClientId = _clientId!,
                    ClientSecret = _clientSecret!
                },
                Context.Empty);

            if (result.Value is not DemoTokenResponse success)
            {
                throw new InvalidOperationException(result.GetRpcFailureMessage());
            }

            _clientAccessToken = success.AccessToken;
            _exchangedAccessToken = null;
            _step2Result = JsonSerializer.Serialize(success, _jsonOptions);
            _step4Result = "尚未执行";
            _step5Result = "尚未执行";
        });
    }

    private async Task GetUserTokenAsync()
    {
        await ExecuteStepAsync("正在模拟用户授权并获取 Token...", async () =>
        {
            var result = await OAuthDemoService.GetUserTokenAsync(new GetDemoUserTokenRequest { RecipientClientId = _clientId }, Context.Empty);
            if (result.Value is not DemoTokenResponse success)
            {
                throw new InvalidOperationException(result.GetRpcFailureMessage());
            }

            _userAccessToken = success.AccessToken;
            _exchangedAccessToken = null;
            _step3Result = JsonSerializer.Serialize(success, _jsonOptions);
            _step4Result = "尚未执行";
            _step5Result = "尚未执行";
        });
    }

    private async Task ExchangeUserTokenAsync()
    {
        await ExecuteStepAsync("正在执行 Token Exchange...", async () =>
        {
            var result = await OAuthDemoService.ExchangeTokenAsync(
                new ExchangeDemoTokenRequest
                {
                    ClientId = _clientId!,
                    ClientSecret = _clientSecret!,
                    ClientAccessToken = _clientAccessToken!,
                    UserAccessToken = _userAccessToken!,
                    RequestedScope = RequestedExchangeScope
                },
                Context.Empty);

            if (result.Value is not DemoTokenResponse success)
            {
                throw new InvalidOperationException(result.GetRpcFailureMessage());
            }

            _exchangedAccessToken = success.AccessToken;
            _step4Result = JsonSerializer.Serialize(success, _jsonOptions);
            _step5Result = "尚未执行";
        });
    }

    private async Task ConsumeExchangedTokenAsync()
    {
        await ExecuteStepAsync("正在调用 Downstream 服务...", async () =>
        {
            var result = await OAuthDemoService.CallDownstreamAsync(
                new CallDemoDownstreamRequest
                {
                    AccessToken = _exchangedAccessToken!
                },
                Context.Empty);

            if (result.Value is not ConsumeDemoAccessTokenResponse success)
            {
                throw new InvalidOperationException(result.GetRpcFailureMessage());
            }

            _step5Result = JsonSerializer.Serialize(success, _jsonOptions);
        });
    }

    private async Task ExecuteStepAsync(string busyText, Func<Task> action)
    {
        try
        {
            _busy = true;
            _busyText = busyText;
            await action();
        }
        catch (Exception ex)
        {
            Message.Error(ex.Message);
        }
        finally
        {
            _busy = false;
            _busyText = "执行中...";
            StateHasChanged();
        }
    }

}
