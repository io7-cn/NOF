@page "/streaming-demo"
@implements IDisposable
@inject SampleMessageService Message
@inject ISampleApi NOFService

<PageTitle>流式传输 Demo</PageTitle>

<div class="sample-page">
    <h1>流式传输 Demo</h1>
    <p class="sample-muted">实时查看服务端推送，也可以测试取消和失败响应。</p>
    <section class="sample-card">
        <h2>调用参数</h2>
        <div class="sample-toolbar">
            <label>Topic<input @bind:event="oninput" @bind="_request.Topic" disabled="@_isStreaming" /></label>
            <label>事件数量<input type="number" @bind:event="oninput" @bind="_request.Count" min="1" max="20" disabled="@_isStreaming" /></label>
            <label>间隔（毫秒）<input type="number" @bind:event="oninput" @bind="_request.IntervalMilliseconds" min="100" max="5000" step="100" disabled="@_isStreaming" /></label>
            <label class="sample-check"><input type="checkbox" @bind="_request.ForceFailure" disabled="@_isStreaming" />返回失败 JSON</label>
        </div>
        <div class="sample-actions">
            <button type="button" class="sample-primary" disabled="@_isStreaming" @onclick="StartStream">开始流式调用</button>
            <button type="button" disabled="@(!_isStreaming)" @onclick="StopStream">停止</button>
            <button type="button" disabled="@_isStreaming" @onclick="ClearEvents">清空</button>
            <span role="status">@(_isStreaming ? "Streaming" : "Idle") · @_events.Count 条事件</span>
        </div>
    </section>
    <section class="sample-card" aria-live="polite" aria-label="服务端事件">
        <h2>服务端事件</h2>
        @if (_events.Count == 0)
        {
            <p class="sample-empty">点击“开始流式调用”后，这里会实时显示服务端推送的事件。</p>
        }
        else
        {
            @foreach (var item in _events)
            {
                <article class="sample-event">
                    <div class="sample-actions"><span class="sample-tag">@item.Topic</span><strong>#@item.Index</strong><time>@item.Timestamp.ToLocalTime().ToString("HH:mm:ss.fff")</time></div>
                    <p>@item.Message</p>
                </article>
            }
        }
    </section>
</div>

@code {
    private readonly List<SampleStreamEvent> _events = [];
    private WatchSampleStreamRequest _request = new();
    private CancellationTokenSource? _streamCancellationTokenSource;
    private bool _isStreaming;

    private async Task StartStream()
    {
        if (_isStreaming)
        {
            return;
        }

        _events.Clear();
        _streamCancellationTokenSource = new CancellationTokenSource();
        _isStreaming = true;

        try
        {
            var result = await NOFService.WatchSampleStreamAsync(
                _request,
                NOF.Abstraction.Context.Empty,
                _streamCancellationTokenSource.Token);
            if (result.Value is not IAsyncEnumerable<SampleStreamEvent> success)
            {
                Message.Error(result.GetRpcFailureMessage());
                return;
            }

            await foreach (var item in success.WithCancellation(_streamCancellationTokenSource.Token))
            {
                _events.Add(item);
                await InvokeAsync(StateHasChanged);
            }

            Message.Success("流式调用完成");
        }
        catch (OperationCanceledException)
        {
            Message.Warning("流式调用已取消");
        }
        catch (Exception ex)
        {
            Message.Error($"流式调用失败: {ex.Message}");
        }
        finally
        {
            _streamCancellationTokenSource?.Dispose();
            _streamCancellationTokenSource = null;
            _isStreaming = false;
            await InvokeAsync(StateHasChanged);
        }
    }

    private void StopStream()
    {
        _streamCancellationTokenSource?.Cancel();
    }

    private void ClearEvents()
    {
        if (_isStreaming)
        {
            return;
        }

        _events.Clear();
    }

    public void Dispose()
    {
        _streamCancellationTokenSource?.Cancel();
        _streamCancellationTokenSource?.Dispose();
    }
}
