@inject SampleMessageService Message
@inject ISampleApi NOFService

<div class="sample-tree-root" @ondragover:preventDefault @ondrop="() => MoveNode(null)">
    <p class="sample-muted">展开节点查看子项；拖动节点到其他节点可更改父节点，拖到此处可移回根节点。</p>
    @if (_nodes.Count == 0)
    {
        <p class="sample-empty">暂无配置节点</p>
    }
    else
    {
        <ul class="sample-tree" aria-label="配置树">
            @foreach (var node in _nodes)
            {
                <ConfigTreeNode @key="(node.Id, _revision)" Node="node" SelectedId="_selectedId" OnSelect="SelectNode"
                                OnAddChild="OnAddChild" OnDelete="OnDeleteNode" OnDrag="DragNode" OnDrop="MoveNode" />
            }
        </ul>
    }
</div>

@code {
    [Parameter] public EventCallback<long> OnSelectNode { get; set; }
    [Parameter] public EventCallback<long?> OnAddChild { get; set; }
    [Parameter] public EventCallback<long> OnDeleteNode { get; set; }

    private List<ConfigNodeDto> _nodes = [];
    private long? _selectedId;
    private long? _draggedId;
    private int _revision;

    protected override async Task OnInitializedAsync() => await ReloadNode(null);

    public async Task ReloadNode(long? parentId)
    {
        try
        {
            var result = await NOFService.GetRootConfigNodesAsync(new GetRootConfigNodesRequest(), Context.Empty);
            _nodes = Message.UnwrapWithMessage(result)?.Nodes ?? [];
            _revision++;
            await InvokeAsync(StateHasChanged);
        }
        catch (Exception exception)
        {
            Message.Error(exception.Message);
        }
    }

    private async Task SelectNode(long id)
    {
        _selectedId = id;
        await OnSelectNode.InvokeAsync(id);
    }

    private void DragNode(long id) => _draggedId = id;

    private async Task MoveNode(long? parentId)
    {
        if (_draggedId is not long id || parentId == id)
        {
            return;
        }

        _draggedId = null;
        try
        {
            var result = await NOFService.UpdateConfigNodeParentAsync(new UpdateConfigNodeParentRequest
            {
                NodeId = id,
                NewParentId = parentId
            }, Context.Empty);
            if (result.Value is NOF.Contract.Empty)
            {
                Message.Success("节点移动成功");
                await ReloadNode(null);
            }
            else
            {
                Message.Error(result.GetRpcFailureMessage());
            }
        }
        catch (Exception exception)
        {
            Message.Error(exception.Message);
        }
    }
}
