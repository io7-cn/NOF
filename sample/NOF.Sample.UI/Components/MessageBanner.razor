@implements IDisposable
@inject SampleMessageService Message

@if (Message.Text is not null)
{
    <div class="sample-notification @Message.Level" role="status" aria-live="polite">
        <span>@Message.Text</span>
        <button type="button" aria-label="关闭提示" @onclick="Message.Dismiss">×</button>
    </div>
}

@code {
    protected override void OnInitialized() => Message.Changed += OnChanged;

    private void OnChanged() => _ = InvokeAsync(StateHasChanged);

    public void Dispose() => Message.Changed -= OnChanged;
}
