<Project>
  <Import Project="..\Directory.Packages.props" />
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
  </PropertyGroup>
  <ItemGroup>
    <!-- Aspire's security-fixed AppHost requires OpenTelemetry 1.17 in the sample host. -->
    <PackageVersion Update="OpenTelemetry.Exporter.OpenTelemetryProtocol" Version="[1.17.0,1.18.0)" Condition="'$(MSBuildProjectName)' == 'NOF.Sample.AppHost'" />
    <PackageVersion Update="OpenTelemetry.Extensions.Hosting" Version="[1.17.0,1.18.0)" Condition="'$(MSBuildProjectName)' == 'NOF.Sample.AppHost'" />
    <PackageVersion Include="Aspire.Hosting" Version="13.6.5" />
    <PackageVersion Include="Aspire.Hosting.Garnet" Version="13.1.0" />
    <PackageVersion Include="Aspire.Hosting.PostgreSQL" Version="13.1.0" />
    <PackageVersion Include="Aspire.Hosting.RabbitMQ" Version="13.1.0" />
    <PackageVersion Include="MessagePack" Version="[2.5.307,3.0.0)" />
    <!-- Align the sample Blazor packages with the .NET 11 runtime. -->
    <PackageVersion Update="Microsoft.AspNetCore.Components" Version="[11.0.0,11.1.0)" />
    <PackageVersion Update="Microsoft.AspNetCore.Components.WebAssembly" Version="[11.0.0,11.1.0)" />
    <PackageVersion Update="Microsoft.JSInterop" Version="[11.0.0,11.1.0)" />
    <PackageVersion Include="Microsoft.AspNetCore.Components.Web" Version="11.0.0" />
    <PackageVersion Include="Microsoft.AspNetCore.Components.WebAssembly.Server" Version="11.0.0" />
    <PackageVersion Include="Microsoft.AspNetCore.Components.WebAssembly.DevServer" Version="11.0.0" />
    <!-- EF design tooling brings Pkcs transitively; retain its major version with security fixes. -->
    <PackageVersion Include="System.Security.Cryptography.Pkcs" Version="[9.0.21,10.0.0)" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.11" />
    <PackageVersion Include="Microsoft.Extensions.Logging.Debug" Version="11.0.0" />
    <PackageVersion Include="Microsoft.Extensions.Configuration.Json" Version="11.0.0" />
    <PackageVersion Update="Microsoft.Extensions.*" Version="[11.0.0,11.1.0)" />
  </ItemGroup>
</Project>
