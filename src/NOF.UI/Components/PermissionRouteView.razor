@using NOF.Authorization
    <AuthGuard Policy="@Policy" AuthorizingContent="@AuthorizingContent"
               UnauthorizedContent="@UnauthorizedContent">
        <RouteView RouteData="@RouteData" DefaultLayout="@DefaultLayout" />
    </AuthGuard>

@code {
    [Parameter, EditorRequired] public RouteData RouteData { get; set; } = default!;
    [Parameter] public Type? DefaultLayout { get; set; }
    [Parameter] public RenderFragment? AuthorizingContent { get; set; }
    [Parameter] public RenderFragment? UnauthorizedContent { get; set; }
    /// <summary>The explicit UI route policy; Contract declarations are not inspected.</summary>
    [Parameter, EditorRequired] public AuthorizationPolicy Policy { get; set; } = default!;

    protected override void OnParametersSet() => ArgumentNullException.ThrowIfNull(Policy);
}
