@implements IDisposable
@using NOF.Abstraction
@using NOF.Authorization
@inject IUserContext UserContext
@inject IPermissionChecker Permissions

@if (!_initialized)
{
    @AuthorizingContent
}
else if (_isAuthorized)
{
    @ChildContent
}
else
{
    @UnauthorizedContent
}

@code {
    [Parameter, EditorRequired] public RenderFragment? ChildContent { get; set; }
    [Parameter] public string? Permission { get; set; }
    /// <summary>Optional UI-owned policy; no UseCase binding or page Attribute lookup is performed.</summary>
    [Parameter] public AuthorizationPolicy? Policy { get; set; }
    [Parameter] public RenderFragment? AuthorizingContent { get; set; }
    [Parameter] public RenderFragment? UnauthorizedContent { get; set; }

    private bool _initialized;
    private bool _isAuthorized;
    private bool _disposed;
    private CancellationTokenSource? _refresh;

    protected override void OnInitialized()
    {
        UserContext.StateChanged += HandleAuthorizationStateChanged;
    }

    protected override async Task OnParametersSetAsync()
    {
        await RefreshStateAsync();
    }

    private async Task RefreshStateAsync()
    {
        if (_disposed)
        {
            return;
        }
        _refresh?.Cancel();
        _refresh?.Dispose();
        var refresh = _refresh = new();
        _initialized = false;
        if (Policy is not null && Permission is not null)
        {
            throw new InvalidOperationException("Specify Policy or Permission, not both.");
        }
        var policy = Policy ?? new AuthorizationPolicy(true,
            string.IsNullOrWhiteSpace(Permission) ? [] : [new([Permission])]);
        try
        {
            var decision = await Permissions.CheckAsync(policy, UserContext.User, Context.Current, refresh.Token);
            if (!_disposed && !refresh.IsCancellationRequested)
            {
                _isAuthorized = decision switch
                {
                    PermissionCheckResult.Granted => true,
                    PermissionCheckResult.AuthenticationRequired => false,
                    PermissionCheckResult.Denied => false,
                    null => throw new InvalidOperationException("The permission checker returned an uninitialized decision.")
                };
                _initialized = true;
            }
        }
        catch (OperationCanceledException) when (refresh.IsCancellationRequested)
        {
        }
    }

    private void HandleAuthorizationStateChanged()
    {
        if (_disposed)
        {
            return;
        }
        _ = InvokeAsync(async () =>
        {
            await RefreshStateAsync();
            if (!_disposed)
            {
                StateHasChanged();
            }
        });
    }

    public void Dispose()
    {
        _disposed = true;
        _refresh?.Cancel();
        _refresh?.Dispose();
        UserContext.StateChanged -= HandleAuthorizationStateChanged;
    }
}
